# Stellar network configuration for deployment scripts
# Copy this file to .env and fill in your values

# Source identity for contract deployment (stellar keys name)
STELLAR_SOURCE=test

# Network: local | testnet | futurenet | mainnet
STELLAR_NETWORK=testnet

# RPC URL (optional — defaults to network standard if unset)
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase (optional — set automatically for known networks)
# STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
